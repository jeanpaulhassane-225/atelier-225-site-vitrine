---
import type { Service } from '../consts';

interface Props {
  service: Service;
  index: number;
  detaille?: boolean;
}

const { service, index, detaille = false } = Astro.props;
const numero = String(index + 1).padStart(2, '0');
---

<article class="service" id={service.slug} style={`--accent: ${service.accent}`}>
  <p class="service__num tnum" aria-hidden="true">{numero}</p>
  <div class="service__body">
    <h3 class="service__title">{service.titre}</h3>
    <p class="service__resume text-dim">{service.resume}</p>
    {
      detaille && (
        <ul class="service__points" role="list">
          {service.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s) var(--space-m);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--line);
  }
  .service__num {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--accent);
    line-height: 1;
  }
  .service__title {
    font-size: var(--step-2);
  }
  .service__resume {
    margin-block-start: 0.5rem;
    max-width: 52ch;
  }
  .service__points {
    display: grid;
    gap: 0.5rem;
    margin-block-start: var(--space-s);
    max-width: 52ch;
  }
  .service__points li {
    padding-inline-start: 1.4em;
    position: relative;
  }
  .service__points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 0.55em;
    block-size: 2px;
    background: var(--accent);
  }
  @media (min-width: 40rem) {
    .service {
      grid-template-columns: 4rem 1fr;
      gap: var(--space-m) var(--space-l);
      padding-block: var(--space-l);
    }
  }
</style>
