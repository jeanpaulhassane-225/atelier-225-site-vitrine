---
import { SITE, NAV } from '../consts';

const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const estActif = (href: string) =>
  href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" translate="no" aria-label={`${SITE.nom}, accueil`}>
      <svg class="brand__mark" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
        <rect x="1" y="1" width="38" height="38" rx="9" fill="none" stroke="currentColor" stroke-opacity="0.28" />
        <path
          d="M6 20h3.2l2.3-8 3.4 17 3.3-12.5 2.1 6.5 1.8-3 1.9 2.2H34"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="brand__name">{SITE.nom}</span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <button
        type="button"
        class="site-nav__toggle"
        aria-expanded="false"
        aria-controls="menu-principal"
      >
        <span class="site-nav__toggle-label">Menu</span>
        <svg class="site-nav__toggle-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <line x1="3" y1="6" x2="17" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="3" y1="10" x2="17" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="3" y1="14" x2="17" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>

      <ul id="menu-principal" class="site-nav__list" role="list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-nav__link"
                aria-current={estActif(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/contact" class="btn site-nav__cta">Démarrer un projet</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--surface);
    border-block-end: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-block-size: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--accent);
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .site-nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.8em;
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    cursor: pointer;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
  }
  .site-nav__link {
    text-decoration: none;
    font-weight: 500;
    color: var(--text-dim);
    padding-block: 0.4rem;
    transition: color var(--dur-1) var(--ease-out);
  }
  .site-nav__link:hover {
    color: var(--text);
  }
  .site-nav__link[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .site-nav__cta {
    font-size: var(--step--1);
    padding: 0.6em 1.1em;
  }

  /* Repli mobile : le bouton pilote l'affichage de la liste. */
  @media (max-width: 51rem) {
    .site-nav__toggle {
      order: 2;
    }
    .site-nav__list {
      position: absolute;
      inset-inline: 0;
      inset-block-start: var(--header-h);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-s) var(--gutter) var(--space-l);
      background: var(--surface);
      border-block-end: 1px solid var(--line);
      box-shadow: var(--shadow-2);
    }
    .site-nav__list:not([data-ouvert]) {
      display: none;
    }
    .site-nav__link {
      padding-block: 0.9rem;
      border-block-end: 1px solid var(--line);
      font-size: var(--step-1);
    }
    .site-nav__link[aria-current='page'] {
      box-shadow: none;
      color: var(--accent);
    }
    .site-nav__cta {
      margin-block-start: var(--space-m);
      font-size: var(--step-0);
      padding: 0.9em 1.2em;
    }
  }
  @media (min-width: 51.0625rem) {
    .site-nav__toggle {
      display: none;
    }
  }
</style>

<script>
  // Menu mobile. Îlot minimal : ~20 lignes, chargées seulement ici.
  const setup = () => {
    const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle');
    const list = document.querySelector<HTMLUListElement>('#menu-principal');
    if (!toggle || !list) return;

    const fermer = () => {
      list.removeAttribute('data-ouvert');
      toggle.setAttribute('aria-expanded', 'false');
    };
    const basculer = () => {
      const ouvert = list.toggleAttribute('data-ouvert');
      toggle.setAttribute('aria-expanded', String(ouvert));
    };

    toggle.addEventListener('click', basculer);
    list.addEventListener('click', (e) => {
      if (e.target instanceof HTMLElement && e.target.closest('a')) fermer();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') fermer();
    });
  };

  setup();
  // Re-brancher après une navigation par View Transitions (le DOM du header est remplacé).
  document.addEventListener('astro:after-swap', setup);
</script>
